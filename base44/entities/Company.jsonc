{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company/Tenant trading name"
    },
    "store_name": {
      "type": "string",
      "description": "Unique store name shown to customers and used for the public store link"
    },
    "store_slug": {
      "type": "string",
      "description": "URL-safe version of the store name, unique per tenant"
    },
    "store_address": {
      "type": "string",
      "description": "Store address printed on receipts and shown on the store page"
    },
    "type": {
      "type": "string",
      "enum": [
        "warehouse",
        "retail_store",
        "restaurant",
        "pharmacy",
        "other"
      ],
      "default": "retail_store"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "show_currency_symbol": {
      "type": "boolean",
      "default": true,
      "description": "Show currency symbol (e.g. \u20a6) alongside amounts. On by default."
    },
    "logo_url": {
      "type": "string"
    },
    "goodwill_message": {
      "type": "string",
      "description": "Footer message on receipts/invoices",
      "default": "Thank you for your business!"
    },
    "first_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the store first started using the app \u2014 the anchor for its usage history, sales performance timeline and renewal countdown"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "pending_activation",
        "active",
        "past_due",
        "suspended",
        "comped"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "red",
        "blue"
      ],
      "default": "pending_activation",
      "description": "Subscription state that decides whether the store opens"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "first_month",
        "monthly",
        "annual"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ],
      "default": "annual",
      "description": "Chosen billing plan: the \u20a61,500 first month, monthly, or annual"
    },
    "activation_fee": {
      "type": "number",
      "default": 0,
      "description": "One-off sign-up fee for this store"
    },
    "activation_paid": {
      "type": "boolean",
      "default": false,
      "description": "Set once the one-off sign-up fee has been received"
    },
    "subscription_amount": {
      "type": "number",
      "description": "Amount charged for the current billing cycle"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date",
      "description": "Date access is paid through \u2014 the store locks after it until renewed"
    },
    "payment_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the owner asked to activate or renew the store"
    },
    "billing_override": {
      "type": "boolean",
      "default": false,
      "description": "Developer granted manual access \u2014 billing does not lock this store"
    },
    "billing_notes": {
      "type": "string",
      "description": "Developer notes about this store's billing"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "none",
        "trial",
        "first_month",
        "monthly",
        "yearly",
        "annual",
        "one_time"
      ],
      "default": "none"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "description": "Only used when the developer turns trials back on"
    },
    "payment_gateway": {
      "type": "string",
      "enum": [
        "paypal",
        "mainstack",
        "stripe",
        "paystack"
      ],
      "description": "Preferred payment gateway"
    },
    "payment_gateway_customer_id": {
      "type": "string"
    },
    "monthly_price": {
      "type": "number",
      "description": "Legacy monthly price override"
    },
    "yearly_price": {
      "type": "number",
      "description": "Legacy yearly price override"
    },
    "first_month_price": {
      "type": "number",
      "description": "Legacy first-month price"
    },
    "one_time_price": {
      "type": "number",
      "description": "Legacy one-time price"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial",
        "expired",
        "pending_payment"
      ],
      "default": "pending_payment"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.company_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}