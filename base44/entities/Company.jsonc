{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company/Tenant name"
    },
    "type": {
      "type": "string",
      "enum": [
        "warehouse",
        "retail_store",
        "restaurant",
        "pharmacy",
        "other"
      ],
      "default": "retail_store"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "show_currency_symbol": {
      "type": "boolean",
      "default": true,
      "description": "Show currency symbol (e.g. \u20a6) alongside amounts. On by default."
    },
    "logo_url": {
      "type": "string"
    },
    "goodwill_message": {
      "type": "string",
      "description": "Footer message on receipts/invoices",
      "default": "Thank you for your business!"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "trial",
        "monthly",
        "yearly",
        "one_time"
      ],
      "default": "trial"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "description": "90 days trial end date"
    },
    "payment_gateway": {
      "type": "string",
      "enum": [
        "paypal",
        "mainstack",
        "stripe",
        "paystack"
      ],
      "description": "Preferred payment gateway"
    },
    "payment_gateway_customer_id": {
      "type": "string"
    },
    "monthly_price": {
      "type": "number",
      "default": 5
    },
    "yearly_price": {
      "type": "number",
      "default": 57
    },
    "first_month_price": {
      "type": "number",
      "default": 1,
      "description": "Introductory price for the 90-day trial period"
    },
    "one_time_price": {
      "type": "number",
      "default": 360,
      "description": "One-time lifetime payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial",
        "expired"
      ],
      "default": "trial"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.company_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}