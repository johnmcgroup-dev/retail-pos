{
  "name": "Alert",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "low_stock",
        "expiring_soon",
        "reorder_suggestion",
        "out_of_stock",
        "high_demand"
      ],
      "description": "Type of alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "product_id": {
      "type": "string",
      "description": "Related product"
    },
    "product_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "current_stock": {
      "type": "number"
    },
    "reorder_level": {
      "type": "number"
    },
    "suggested_order_quantity": {
      "type": "number"
    },
    "days_until_expiry": {
      "type": "number"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_dismissed": {
      "type": "boolean",
      "default": false
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.company_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}