{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant this activity belongs to"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "sale",
        "return",
        "inventory",
        "invoice"
      ],
      "description": "What kind of record changed"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "adjust",
        "restock"
      ],
      "description": "Type of change"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the affected record"
    },
    "reference_number": {
      "type": "string",
      "description": "Invoice / return number or product name"
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary of the change"
    },
    "amount": {
      "type": "number",
      "description": "Money involved (sale total, refund), if any"
    },
    "performed_by": {
      "type": "string",
      "description": "Email of the user who made the change"
    },
    "performed_by_name": {
      "type": "string",
      "description": "Full name of the user who made the change"
    },
    "details": {
      "type": "object",
      "description": "Snapshot of changed fields for audit"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "entity_type",
    "action",
    "activity_date"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}