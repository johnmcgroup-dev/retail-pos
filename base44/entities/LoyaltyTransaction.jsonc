{
  "name": "LoyaltyTransaction",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Store/tenant the points belong to"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer whose points changed"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "earned",
        "redeemed",
        "expired",
        "adjusted"
      ],
      "enumColors": [
        "green",
        "purple",
        "gray",
        "blue"
      ],
      "description": "Type of loyalty transaction"
    },
    "points": {
      "type": "number",
      "description": "Points earned or redeemed (positive for earned, negative for redeemed)"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "sale",
        "reward",
        "manual",
        "expiration"
      ],
      "description": "What triggered this transaction"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the sale, reward, etc."
    },
    "description": {
      "type": "string",
      "description": "Description of the transaction"
    },
    "balance_after": {
      "type": "number",
      "description": "Customer's point balance after this transaction"
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "transaction_type",
    "points",
    "transaction_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    }
  }
}