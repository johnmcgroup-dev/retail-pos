{
  "name": "Sale",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "tax": {
            "type": "number"
          },
          "discount": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bank_transfer",
        "credit",
        "mobile_money"
      ],
      "default": "cash"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "partial",
        "unpaid"
      ],
      "default": "paid"
    },
    "amount_paid": {
      "type": "number"
    },
    "amount_due": {
      "type": "number"
    },
    "loyalty_points_earned": {
      "type": "number",
      "default": 0,
      "description": "Points earned from this purchase"
    },
    "notes": {
      "type": "string"
    },
    "cashier": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "invoice_number",
    "sale_date",
    "total_amount"
  ]
}