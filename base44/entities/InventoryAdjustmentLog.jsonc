{
  "name": "InventoryAdjustmentLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch/warehouse the adjusted stock belongs to"
    },
    "inventory_id": {
      "type": "string",
      "description": "Reference to Inventory record"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "adjusted_by": {
      "type": "string",
      "description": "Full name of the user who made the change"
    },
    "adjusted_by_email": {
      "type": "string"
    },
    "previous_quantity": {
      "type": "number"
    },
    "new_quantity": {
      "type": "number"
    },
    "change": {
      "type": "number",
      "description": "Positive = increase, negative = decrease"
    },
    "reason": {
      "type": "string",
      "enum": [
        "stock_count",
        "damage",
        "expired",
        "theft",
        "return",
        "supplier_delivery",
        "correction",
        "other"
      ],
      "default": "correction"
    },
    "notes": {
      "type": "string"
    },
    "adjustment_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "product_id",
    "previous_quantity",
    "new_quantity",
    "reason",
    "adjustment_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "data.branch_id": {
                "$in": "{{user.data.branch_ids}}"
              }
            },
            {
              "data.branch_id": {
                "$exists": false
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    }
  }
}