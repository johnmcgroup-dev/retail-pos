{
  "name": "BillingConfig",
  "type": "object",
  "properties": {
    "activation_fee": {
      "type": "number",
      "default": 0,
      "description": "One-off fee charged when a store signs up"
    },
    "first_month_price": {
      "type": "number",
      "default": 1500,
      "description": "Introductory price for a store's first month (\u20a61,500). Later months are charged at the monthly price."
    },
    "annual_price": {
      "type": "number",
      "default": 125000,
      "description": "Yearly subscription price"
    },
    "monthly_price": {
      "type": "number",
      "default": 13500,
      "description": "Monthly subscription price"
    },
    "trials_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Developer switch \u2014 off means every store must pay before it opens"
    },
    "trial_days": {
      "type": "number",
      "default": 0,
      "description": "Days of access granted when trials are enabled"
    },
    "payment_instructions": {
      "type": "string",
      "description": "How tenants pay (bank details, link) shown on the activation screen"
    },
    "checkout_url_annual": {
      "type": "string",
      "description": "Hosted checkout page for the annual plan (Stripe Payment Link, Paystack payment page, Mainstack checkout). Tenants choosing annual are sent straight here."
    },
    "checkout_url_monthly": {
      "type": "string",
      "description": "Hosted checkout page for the monthly plan. Tenants choosing monthly \u2014 or adding extra months \u2014 are sent straight here."
    },
    "checkout_url_first_month": {
      "type": "string",
      "description": "Hosted checkout page for the \u20a61,500 first-month plan. Tenants choosing the first month are sent straight here."
    },
    "updated_by": {
      "type": "string",
      "description": "Email of the developer who last changed these rules"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}