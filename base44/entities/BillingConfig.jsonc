{
  "name": "BillingConfig",
  "type": "object",
  "properties": {
    "activation_fee": {
      "type": "number",
      "default": 1,
      "description": "One-off fee charged when a store signs up"
    },
    "annual_price": {
      "type": "number",
      "default": 69.9,
      "description": "Yearly subscription price"
    },
    "monthly_price": {
      "type": "number",
      "default": 9.9,
      "description": "Monthly subscription price"
    },
    "trials_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Developer switch \u2014 off means every store must pay before it opens"
    },
    "trial_days": {
      "type": "number",
      "default": 0,
      "description": "Days of access granted when trials are enabled"
    },
    "payment_instructions": {
      "type": "string",
      "description": "How tenants pay (bank details, link) shown on the activation screen"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of the developer who last changed these rules"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}