{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string",
      "description": "Warehouse where stock is located"
    },
    "product_id": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "batch_number": {
      "type": "string"
    },
    "manufacturing_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string",
      "description": "Warehouse location/shelf"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "product_id",
    "quantity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    }
  }
}