{
  "name": "LoyaltyProgram",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "points_per_dollar": {
      "type": "number",
      "description": "How many points per dollar spent"
    },
    "redemption_value": {
      "type": "number",
      "description": "Dollar value of each point"
    },
    "minimum_purchase": {
      "type": "number",
      "description": "Minimum purchase to earn points"
    },
    "expiry_months": {
      "type": "number",
      "description": "Points expiry in months (0 = never)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "company_id",
    "name",
    "points_per_dollar"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    }
  }
}