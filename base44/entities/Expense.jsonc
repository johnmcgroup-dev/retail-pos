{
  "name": "Expense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "rent",
        "utilities",
        "salaries",
        "marketing",
        "maintenance",
        "supplies",
        "transport",
        "insurance",
        "taxes",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bank_transfer",
        "check"
      ]
    },
    "receipt_url": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "date",
    "category",
    "amount"
  ]
}