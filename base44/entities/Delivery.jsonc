{
  "name": "Delivery",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch the goods leave from"
    },
    "delivery_number": {
      "type": "string",
      "description": "Unique delivery reference"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "item_summary": {
      "type": "string",
      "description": "What is being sent, e.g. 2 cartons of noodles"
    },
    "fare": {
      "type": "number",
      "description": "Delivery fare agreed with the customer"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "pos",
        "prepaid"
      ],
      "default": "cash"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "enumColors": [
        "red",
        "green"
      ],
      "default": "unpaid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "in_transit",
        "delivered",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "green",
        "red"
      ],
      "default": "pending"
    },
    "rider_name": {
      "type": "string"
    },
    "rider_phone": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "delivery_number",
    "customer_name",
    "delivery_address",
    "fare",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        }
      ]
    }
  }
}