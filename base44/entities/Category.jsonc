{
  "name": "Category",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company that owns this category"
    },
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6",
      "description": "Color code for visual identification"
    },
    "icon": {
      "type": "string",
      "default": "Package",
      "description": "Lucide icon name for this category"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower first)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "data.company_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}